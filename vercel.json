{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    }
  },
  "bindings": [
    {
      "type": "service",
      "service": "backend",
      "format": "url",
      "env": "BACKEND_URL"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}